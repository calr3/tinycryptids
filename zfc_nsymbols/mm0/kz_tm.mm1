@_ def kzAction (q b: nat): nat = $ kzNth b (kzNth q kzTable) $;
@_ def kzState (q l r: nat): nat = $ (q, l, r) $;
@_ def kzQ (s: nat): nat = $ fst s $;
@_ def kzL (s: nat): nat = $ fst (snd s) $;
@_ def kzR (s: nat): nat = $ snd (snd s) $;
@_ def kzWrite (a: nat): nat = $ fst a $;
@_ def kzDir (a: nat): nat = $ fst (snd a) $;
@_ def kzTarget (a: nat): nat = $ snd (snd a) $;
-- tapes are numbers in base kzK, the head cell (right) / the cell left of it (left) lowest
@_ def kzMove (a l r: nat): nat =
$ if (kzDir a = 0)
    (kzState (kzTarget a) (l // kzK) (l % kzK + kzK * (kzWrite a + kzK * (r // kzK))))
    (kzState (kzTarget a) (kzWrite a + kzK * l) (r // kzK)) $;
@_ def kzStep (s: nat): nat =
$ if (kzQ s < kzH) (kzMove (kzAction (kzQ s) (kzR s % kzK)) (kzL s) (kzR s)) s $;
@_ def kzRun (n s .x: nat): nat = $ rec s (\ x, kzStep x) n $;
@_ def kzHalts (.n: nat): wff = $ E. n kzQ (kzRun n (kzState 0 0 0)) = kzH $;
