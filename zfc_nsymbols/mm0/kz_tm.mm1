@_ def kzTable: nat = $ kzRow0 : kzRow1 : kzRow2 : kzRow3 : kzRow4 : kzRow5 : kzRow6 : kzRow7 : kzRow8 : kzRow9 : kzRow10 : kzRow11 : kzRow12 : kzRow13 : kzRow14 : kzRow15 : kzRow16 : kzRow17 : kzRow18 : kzRow19 : kzRow20 : kzRow21 : kzRow22 : kzRow23 : kzRow24 : kzRow25 : kzRow26 : kzRow27 : kzRow28 : kzRow29 : kzRow30 : kzRow31 : kzRow32 : kzRow33 : kzRow34 : kzRow35 : kzRow36 : kzRow37 : kzRow38 : kzRow39 : kzRow40 : kzRow41 : kzRow42 : kzRow43 : kzRow44 : kzRow45 : kzRow46 : kzRow47 : kzRow48 : kzRow49 : kzRow50 : kzRow51 : kzRow52 : kzRow53 : kzRow54 : kzRow55 : kzRow56 : kzRow57 : kzRow58 : kzRow59 : kzRow60 : kzRow61 : kzRow62 : kzRow63 : kzRow64 : kzRow65 : kzRow66 : kzRow67 : kzRow68 : kzRow69 : kzRow70 : kzRow71 : kzRow72 : kzRow73 : kzRow74 : kzRow75 : kzRow76 : kzRow77 : kzRow78 : kzRow79 : kzRow80 : kzRow81 : kzRow82 : kzRow83 : kzRow84 : kzRow85 : kzRow86 : kzRow87 : kzRow88 : kzRow89 : kzRow90 : kzRow91 : kzRow92 : kzRow93 : kzRow94 : kzRow95 : kzRow96 : kzRow97 : kzRow98 : kzRow99 : kzRow100 : kzRow101 : kzRow102 : kzRow103 : kzRow104 : kzRow105 : kzRow106 : kzRow107 : kzRow108 : kzRow109 : kzRow110 : kzRow111 : kzRow112 : kzRow113 : kzRow114 : kzRow115 : kzRow116 : 0 $;

@_ def kzAction (q b: nat): nat = $ kzNth b (kzNth q kzTable) $;
@_ def kzState (q l r: nat): nat = $ (q, l, r) $;
@_ def kzQ (s: nat): nat = $ fst s $;
@_ def kzL (s: nat): nat = $ fst (snd s) $;
@_ def kzR (s: nat): nat = $ snd (snd s) $;
@_ def kzWrite (a: nat): nat = $ fst a $;
@_ def kzDir (a: nat): nat = $ fst (snd a) $;
@_ def kzTarget (a: nat): nat = $ snd (snd a) $;
-- tapes are numbers in base kzK, the head cell (right) / the cell left of it (left) lowest
@_ def kzMove (a l r: nat): nat =
$ if (kzDir a = 0)
    (kzState (kzTarget a) (l // kzK) (l % kzK + kzK * (kzWrite a + kzK * (r // kzK))))
    (kzState (kzTarget a) (kzWrite a + kzK * l) (r // kzK)) $;
@_ def kzStep (s: nat): nat =
$ if (kzQ s < kzH) (kzMove (kzAction (kzQ s) (kzR s % kzK)) (kzL s) (kzR s)) s $;
@_ def kzRun (n s .x: nat): nat = $ rec s (\ x, kzStep x) n $;
@_ def kzHalts (.n: nat): wff = $ E. n kzQ (kzRun n (kzState 0 0 0)) = kzH $;
