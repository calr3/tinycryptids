theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ E x y z : Nat, 3 ≤ E ∧ 1 ≤ x ∧ 1 ≤ y ∧ 1 ≤ z ∧ x ^ E + y ^ E = z ^ E :=
  halts_iff_of_sim delta delta2 phi compat start TM.Fermat.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of_sol h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

