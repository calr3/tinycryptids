theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ p q, Prime p ∧ Prime q ∧ p ≠ q ∧ rep p q ∣ rep q p :=
  halts_iff_of_sim delta delta2 phi compat start TM.FeitThompson.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of (ft_iff.mp h); ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

