theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.z0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ a : List Int, 13 < a.length ∧ IsBarker a :=
  halts_iff_of_sim delta delta2 phi compat start TM.Barker.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

