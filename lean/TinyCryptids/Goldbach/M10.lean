import TinyCryptids.Goldbach.Main

/-! The merged machine (10 states, 6 symbols), generated by `goldbach/gen_lean.py`
from `goldbach/machines/goldbach_10.txt`, and the main theorem carried over to it. -/

namespace TMK.Goldbach

open TM (Dir)
open TinyCryptids

namespace M10

inductive St2
  | mark
  | zl
  | zr
  | rst
  | chk
  | e1
  | e2
  | kr
  | sh
  | wl
deriving DecidableEq, Repr

def delta2 : St2 → Nat → Option (Nat × Dir × St2)
  | .mark, 0 => some (1, .R, .rst)
  | .mark, 1 => some (3, .L, .zl)
  | .mark, 5 => some (5, .R, .e1)
  | .zl, 0 => some (0, .R, .rst)
  | .zl, 1 => some (2, .R, .zr)
  | .zl, 2 => some (2, .L, .zl)
  | .zl, 3 => some (3, .L, .zl)
  | .zl, 5 => some (5, .R, .rst)
  | .zr, 0 => some (0, .L, .chk)
  | .zr, 1 => some (2, .L, .zl)
  | .zr, 2 => some (2, .R, .zr)
  | .zr, 3 => some (3, .R, .zr)
  | .zr, 4 => some (2, .L, .zl)
  | .zr, 5 => some (5, .L, .chk)
  | .rst, 0 => some (1, .L, .rst)
  | .rst, 1 => some (1, .L, .sh)
  | .rst, 2 => some (1, .R, .rst)
  | .rst, 3 => some (3, .L, .zl)
  | .chk, 0 => some (0, .R, .kr)
  | .chk, 1 => some (1, .R, .chk)
  | .chk, 2 => some (1, .L, .chk)
  | .chk, 3 => some (4, .L, .chk)
  | .chk, 4 => some (1, .R, .mark)
  | .chk, 5 => some (1, .L, .sh)
  | .e1, 1 => some (1, .R, .e2)
  | .e2, 1 => some (1, .R, .mark)
  | .kr, 1 => some (1, .R, .kr)
  | .kr, 4 => some (1, .R, .kr)
  | .kr, 5 => some (1, .L, .sh)
  | .sh, 0 => some (1, .R, .e1)
  | .sh, 1 => some (5, .L, .wl)
  | .wl, 0 => some (0, .R, .e1)
  | .wl, 1 => some (1, .L, .wl)
  | .wl, 5 => some (1, .L, .wl)
  | _, _ => none

def start2 : Cfg St2 := ⟨.mark, blank, blank⟩

def phi : St → St2
  | .mark => .mark
  | .zl => .zl
  | .zr => .zr
  | .rst => .rst
  | .chk => .chk
  | .inc => .chk
  | .e1 => .e1
  | .e2 => .e2
  | .kr => .kr
  | .sh => .sh
  | .wl => .wl
  | .g1 => .rst
  | .g2 => .rst

theorem compat : ∀ q a, Compat phi (delta q a) (delta2 (phi q) a) := by
  intro q a
  rcases a with _ | _ | _ | _ | _ | _ | a <;> cases q <;> first | trivial | rfl

/-- **Main theorem**, for the merged machine. -/
theorem halts_iff : Halts delta2 start2 ↔
    ∃ n, 2 ≤ n ∧ ∀ p q, Prime p → Prime q → p + q ≠ 2 * n :=
  halts_iff_of_sim delta delta2 phi compat start TMK.Goldbach.halts_iff
    (fun h => let ⟨c, hr, hq, hs⟩ := haltAt_of h; ⟨c, hr, by rw [hq, hs]; rfl⟩)

/-- The same, with the conjecture as a definition (`TinyCryptids.GoldbachConjecture`). -/
theorem halts_iff_not : Halts delta2 start2 ↔ ¬ GoldbachConjecture := by
  rw [halts_iff]
  constructor
  · rintro ⟨n, hn, h⟩ hg
    obtain ⟨p, q, hp, hq, e⟩ := hg n hn
    exact h p q hp hq e
  · intro hg
    apply Classical.byContradiction; intro hno
    apply hg; intro n hn
    apply Classical.byContradiction; intro hpq
    exact hno ⟨n, hn, fun p q hp hq e => hpq ⟨p, q, hp, hq, e⟩⟩

end M10

end TMK.Goldbach
