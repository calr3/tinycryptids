theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

/-- the merged beep state plays only the design's beep state on symbol 0 -/
theorem excl : ∀ q, phi q = phi St.q9 → q = St.q9 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.w, blank, blank⟩

/-- The beep transition: `q9` reading 0. -/
theorem beep_transition : delta2 St2.q9 false = some (false, Dir.L, St2.a3) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.WallSunSunInf.never_halts

theorem quasihalts_iff :
    QuasiHalts delta2 St2.q9 false start2 ↔ ¬ InfinitelyManyWallSunSunPrimes :=
  (quasihalts_iff_of_sim delta delta2 phi compat start TM.WallSunSunInf.never_halts St.q9 false
    excl).trans TM.WallSunSunInf.quasihalts_iff

