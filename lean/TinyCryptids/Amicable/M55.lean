theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

/-- the merged beep state plays only the design's beep state on symbol 0 -/
theorem excl : ∀ q, phi q = phi St.H5 → q = St.H5 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.k0, blank, blank⟩

/-- The beep transition: `H5` reading 0. -/
theorem beep_transition : delta2 St2.H5 false = some (false, Dir.R, St2.x1) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.Amicable.never_halts

theorem quasihalts_iff :
    QuasiHalts delta2 St2.H5 false start2 ↔ ¬ InfinitelyManyAmicable :=
  (quasihalts_iff_of_sim delta delta2 phi compat start TM.Amicable.never_halts St.H5 false
    excl).trans TM.Amicable.quasihalts_iff

