theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ n k, 0 < n ∧ 0 < k ∧ iterate collatz k n = n ∧ n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4 :=
  halts_iff_of_sim delta delta2 phi compat start TM.WeakCollatz.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of_cycle h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

