  | p0, false => some (true, L, sp)
  | p0, true => some (true, R, p1)
  | p1, false => some (false, R, os)
  | p1, true => some (true, R, p0)
  | sp, false => none
  | sp, true => some (false, L, gm1)
  | gm1, false => none
  | gm1, true => some (true, L, gm2)
  | gm2, false => some (false, R, c0)
  | gm2, true => some (false, R, hr)
  | hr, false => some (true, L, hm)
  | hr, true => some (true, R, hr)
  | hm, false => none
  | hm, true => some (false, L, ge)
  | ge, false => some (true, L, gm1)
  | ge, true => some (true, L, ge)
  | c0, false => none
  | c0, true => some (true, R, c1)
  | c1, false => some (true, R, b1)
  | c1, true => some (true, R, p0)
  | os, false => none
  | os, true => some (false, L, go)
  | go, false => some (true, L, og)
  | go, true => some (true, L, go)
  | og, false => some (false, R, hf)
  | og, true => some (false, R, hr2)
  | hr2, false => some (true, R, hx1)
  | hr2, true => some (true, R, hr2)
  | hx1, false => some (false, L, a2)
  | hx1, true => some (true, R, hx2)
  | hx2, false => some (false, L, a2)
  | hx2, true => some (false, L, go)
  | hf, false => some (false, R, pk1)
  | hf, true => some (true, R, hf)
  | pk1, false => some (true, L, s0)
  | pk1, true => some (true, R, pk2)
  | pk2, false => some (false, R, halt)
  | pk2, true => some (true, L, s0)
  | a2, false => some (true, R, b1)
  | a2, true => some (true, L, a2)
  | b1, false => some (true, L, b2)
  | b1, true => some (true, R, b1)
  | b2, false => none
  | b2, true => some (false, L, gl)
  | halt, _ => none

def start : Cfg St := ⟨St.seed, blank, blank⟩

end TM.WeakCollatz
