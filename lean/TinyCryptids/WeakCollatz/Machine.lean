open St Dir in
def delta : St → Bool → Option (Bool × Dir × St)
  | seed, false => some (true, R, hf)
  | seed, true => none
  | s0, false => some (false, L, gl)
  | s0, true => some (true, L, s0)
  | gl, false => some (false, R, p0)
