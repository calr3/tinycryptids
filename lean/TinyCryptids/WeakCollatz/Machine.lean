import TinyCryptids.Core.Basic

/-! The 25-state design, generated by `gen_lean.py` from `weakcollatz.txt`. -/

namespace TM.WeakCollatz

inductive St
  | seed
  | s0
  | gl
  | p0
  | p1
  | sp
  | gm1
  | gm2
  | hr
