theorem halts_iff :
    Halts delta2 start2 ↔ ∃ p q, Prime p ∧ Prime q ∧ p < q ∧ (∀ r, p < r → r < q → ¬ Prime r) ∧ 4 * p ≤ (q - p - 1) ^ 2 :=
  halts_iff_of_sim delta delta2 phi compat start TM.Andrica.halts_iff
