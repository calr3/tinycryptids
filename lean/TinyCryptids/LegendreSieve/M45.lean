theorem halts_iff :
    Halts delta2 start2 ↔ ∃ n, 1 ≤ n ∧ ∀ p, n ^ 2 < p → p < (n + 1) ^ 2 → ¬ TinyCryptids.Prime p :=
  halts_iff_of_sim delta delta2 phi compat start TM.LegendreSieve.halts_iff
