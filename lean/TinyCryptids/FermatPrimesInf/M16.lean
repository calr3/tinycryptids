import TinyCryptids.FermatPrimesInf.Main

/-! M16: 16-state machine generated by `gen_reduced_lean.py` from `machines/fermatprimesinf_16.txt`.
Its beep transition is `G0` reading 0. -/

namespace TM.FermatPrimesInf

open TinyCryptids

namespace M16

inductive St2
  | C4
  | B2
  | Y1
  | Y2
  | A2
  | W1
  | Z1
  | Z2
  | E
  | V
  | X1
  | X
  | Q
  | HF
  | H1
  | G0
  | halt2
deriving DecidableEq, Repr

open St2 Dir in
def delta2 : St2 → Bool → Option (Bool × Dir × St2)
  | C4, false => some (true, L, H1)
  | C4, true => some (true, L, C4)
  | B2, false => some (false, L, E)
  | B2, true => some (false, L, Y1)
  | Y1, false => some (false, L, Y2)
  | Y1, true => some (true, L, Y1)
  | Y2, false => some (true, R, A2)
  | Y2, true => some (true, L, Y2)
  | A2, false => some (false, L, W1)
  | A2, true => some (false, R, Z1)
  | W1, false => some (false, R, A2)
  | W1, true => some (true, L, W1)
  | Z1, false => some (false, R, Z2)
  | Z1, true => some (true, R, Z1)
  | Z2, false => some (true, R, B2)
  | Z2, true => some (true, R, Z2)
  | E, false => none
  | E, true => some (false, L, V)
  | V, false => some (true, L, X1)
  | V, true => some (true, L, V)
  | X1, false => some (true, R, C4)
  | X1, true => some (false, L, X)
  | X, false => some (false, L, Q)
  | X, true => some (false, L, X)
  | Q, false => some (false, R, HF)
  | Q, true => some (true, R, H1)
  | HF, false => some (true, R, HF)
  | HF, true => some (true, L, C4)
  | H1, false => some (true, R, H1)
  | H1, true => some (true, R, G0)
  | G0, false => some (false, L, C4)
  | G0, true => some (false, R, B2)
  | halt2, _ => none

def phi : St → St2
  | St.C4 => St2.C4
  | St.B2 => St2.B2
  | St.Y1 => St2.Y1
  | St.Y2 => St2.Y2
  | St.A2 => St2.A2
  | St.W1 => St2.W1
  | St.W2 => St2.A2
  | St.Z1 => St2.Z1
  | St.Z2 => St2.Z2
  | St.E => St2.E
  | St.V => St2.V
  | St.X1 => St2.X1
  | St.X => St2.X
  | St.Q => St2.Q
  | St.HF => St2.HF
  | St.H1 => St2.H1
  | St.G0 => St2.G0
  | St.halt => St2.halt2

theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

/-- the merged beep state plays only the design's beep state on symbol 0 -/
theorem excl : ∀ q, phi q = phi St.G0 → q = St.G0 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.C4, blank, blank⟩

/-- The beep transition: `G0` reading 0. -/
theorem beep_transition : delta2 St2.G0 false = some (false, Dir.L, St2.C4) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.FermatPrimesInf.never_halts

theorem quasihalts_iff :
    QuasiHalts delta2 St2.G0 false start2 ↔ ¬ InfinitelyManyFermatPrimes :=
  (quasihalts_iff_of_sim delta delta2 phi compat start TM.FermatPrimesInf.never_halts St.G0 false
    excl).trans TM.FermatPrimesInf.quasihalts_iff

end M16

end TM.FermatPrimesInf
