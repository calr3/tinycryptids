import TinyCryptids.Core.Basic

/-! The 15-state design, generated by `gen_lean.py` from `machines/erdos_15.txt`. -/

namespace TM.Erdos

inductive St
  | A
  | B
  | C
  | D
  | E
  | F
  | G
  | H
  | I
  | J
  | K
  | L
  | M
  | N
  | O
  | halt
deriving DecidableEq, Repr

open St Dir in
def delta : St → Bool → Option (Bool × Dir × St)
  | A, false => some (true, R, B)
  | A, true => some (true, R, O)
  | B, false => some (false, R, C)
  | B, true => some (false, R, C)
  | C, false => some (false, R, D)
  | C, true => some (true, R, J)
  | D, false => some (false, L, E)
  | D, true => some (true, R, C)
  | E, false => some (false, L, F)
  | E, true => some (true, L, K)
  | F, false => some (false, L, G)
  | F, true => some (true, L, E)
  | G, false => some (false, L, H)
  | G, true => some (true, L, F)
  | H, false => some (true, R, I)
  | H, true => some (false, L, St.L)
  | I, false => some (false, R, B)
  | I, true => some (true, L, K)
  | J, false => some (true, R, C)
  | J, true => some (false, R, A)
  | K, false => some (false, L, I)
  | K, true => some (true, L, N)
  | St.L, false => some (true, R, M)
  | St.L, true => none
  | M, false => some (false, R, I)
  | M, true => some (false, R, O)
  | N, false => some (false, L, K)
  | N, true => some (true, L, K)
  | O, false => some (true, L, M)
  | O, true => some (true, R, A)
  | halt, _ => none

def start : Cfg St := ⟨St.A, blank, blank⟩

end TM.Erdos
