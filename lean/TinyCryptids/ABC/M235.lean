set_option maxHeartbeats 0 in
theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

set_option maxHeartbeats 0 in
/-- the merged beep state plays only the design's beep state on symbol 0 -/
theorem excl_beep : ∀ q, phi q = phi St.xe3 → q = St.xe3 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

set_option maxHeartbeats 0 in
/-- the merged boop state plays only the design's boop state on symbol 0 -/
theorem excl_boop : ∀ q, phi q = phi St.xq6 → q = St.xq6 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

/-- The beep transition: `xe3` reading 0. -/
theorem beep_transition : delta2 St2.xe3 false = some (false, Dir.R, St2.bp1) := rfl

/-- The boop transition: `xq6` reading 0. -/
theorem boop_transition : delta2 St2.xq6 false = some (false, Dir.R, St2.pt2) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.ABC.never_halts

theorem repeats_iff :
    RepeatsForever delta2 St2.xe3 false St2.xq6 false start2 ↔ ¬ ABCConjecture :=
  (repeatsForever_iff_of_sim delta delta2 phi compat start TM.ABC.never_halts St.xe3 false
    St.xq6 false excl_beep excl_boop).trans TM.ABC.repeats_iff

