theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ a b c d e f g : Nat, 1 ≤ a ∧ 1 ≤ b ∧ 1 ≤ c ∧ a * a + b * b = d * d ∧ a * a + c * c = e * e ∧ b * b + c * c = f * f ∧ a * a + b * b + c * c = g * g :=
  halts_iff_of_sim delta delta2 phi compat start TM.PerfectCuboid.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

