import TinyCryptids.PAK.Comp
import TinyCryptids.PA.Code

/-! The candidates of an iteration of the 10-symbol machine, generated by
`pa_nsymbols/gen_klean.py`: each axiom in the form and relabelling of `configs.py` (D = 8) as a
code over the parameters, its chain of operations (`kc<X>`) and the lemma that the chain keeps
that code (or the selection when `axiomcode` is 0); main's operations grouped into the decoding,
`v_0`, the candidates, GEN and DET (`iterK`), which is what main computes (`k0_eq`). -/

namespace TMK.PA

open TM.PA (A negC eqC elC impC allC exC andC)

-- every candidate takes all three parameters, some ignore one
set_option linter.unusedVariables false

def decodeK (a : A) : A := a.reload.zeroAc.zeroP1.zeroP3.decAc.decP1.decP2.decP3

/-- B2 (formal parameters `a b c` = `p1 p3 p2`, form 0) -/
def axB2 (p1 p2 p3 : Nat) : Nat := (impC (impC (negC p1) p1) p1)

def kcB2 (a : A) : A := a.par1.push.incT.incT.incT.cons.par1.cons.push.incT.incT.cons.par1.cons.push.incT.incT.cons.select

theorem kcB2_eq (a : A) : kcB2 a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB2 a.p1 a.p2 a.p3 } := by
  simp only [kcB2, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B6c (formal parameters `a b c` = `p2 p1 p3`, form 0) -/
def axB6c (p1 p2 p3 : Nat) : Nat := (impC (exC p2 (allC p2 p1)) p1)

def kcB6c (a : A) : A := a.par2.par2.par1.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.par1.cons.push.incT.incT.cons.select

theorem kcB6c_eq (a : A) : kcB6c a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB6c a.p1 a.p2 a.p3 } := by
  simp only [kcB6c, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B3 (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB3 (p1 p2 p3 : Nat) : Nat := (impC p2 (impC (negC p2) p3))

def kcB3 (a : A) : A := a.par2.par2.push.incT.incT.incT.cons.par3.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB3_eq (a : A) : kcB3 a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB3 a.p1 a.p2 a.p3 } := by
  simp only [kcB3, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B8b (formal parameters `a b c` = `p2 p1 p3`, form 1) -/
def axB8b (p1 p2 p3 : Nat) : Nat := (impC (elC p2 p3) (impC (eqC p2 p1) (elC p1 p3)))

def kcB8b (a : A) : A := a.par2.par3.cons.push.incT.cons.par2.par1.cons.push.cons.par1.par3.cons.push.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB8b_eq (a : A) : kcB8b a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB8b a.p1 a.p2 a.p3 } := by
  simp only [kcB8b, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B8c (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB8c (p1 p2 p3 : Nat) : Nat := (impC (eqC p2 p3) (impC (elC p1 p2) (elC p1 p3)))

def kcB8c (a : A) : A := a.par2.par3.cons.push.cons.par1.par2.cons.push.incT.cons.par1.par3.cons.push.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB8c_eq (a : A) : kcB8c a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB8c a.p1 a.p2 a.p3 } := by
  simp only [kcB8c, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B8a (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB8a (p1 p2 p3 : Nat) : Nat := (impC (eqC p2 p3) (impC (eqC p2 p1) (eqC p3 p1)))

def kcB8a (a : A) : A := a.par2.par3.cons.push.cons.par2.par1.cons.push.cons.par3.par1.cons.push.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB8a_eq (a : A) : kcB8a a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB8a a.p1 a.p2 a.p3 } := by
  simp only [kcB8a, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B1 (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB1 (p1 p2 p3 : Nat) : Nat := (impC (impC p2 p3) (impC (impC p3 p1) (impC p2 p1)))

def kcB1 (a : A) : A := a.par2.par3.cons.push.incT.incT.cons.par3.par1.cons.push.incT.incT.cons.par2.par1.cons.push.incT.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB1_eq (a : A) : kcB1 a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB1 a.p1 a.p2 a.p3 } := by
  simp only [kcB1, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B4 (formal parameters `a b c` = `p2 p3 p1`, form 1) -/
def axB4 (p1 p2 p3 : Nat) : Nat := (impC (allC p2 p3) (impC (allC p2 (impC p3 p1)) (allC p2 p1)))

def kcB4 (a : A) : A := a.par2.par3.cons.push.incT.incT.incT.incT.cons.par2.par3.par1.cons.push.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.par2.par1.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB4_eq (a : A) : kcB4 a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB4 a.p1 a.p2 a.p3 } := by
  simp only [kcB4, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B6b (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB6b (p1 p2 p3 : Nat) : Nat := (impC (allC p2 (allC p3 p1)) (allC p3 (allC p2 p1)))

def kcB6b (a : A) : A := a.par2.par3.par1.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.par3.par2.par1.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.cons.select

theorem kcB6b_eq (a : A) : kcB6b a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB6b a.p1 a.p2 a.p3 } := by
  simp only [kcB6b, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B7 (formal parameters `a b c` = `p2 p1 p3`, form 0) -/
def axB7 (p1 p2 p3 : Nat) : Nat := (exC p2 (eqC p2 p1))

def kcB7 (a : A) : A := a.par2.par2.par1.cons.push.cons.push.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.select

theorem kcB7_eq (a : A) : kcB7 a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB7 a.p1 a.p2 a.p3 } := by
  simp only [kcB7, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- E (formal parameters `a b c` = `p3 p1 p2`, form 1) -/
def axE (p1 p2 p3 : Nat) : Nat := (exC 1 (allC 0 (andC (impC (allC 1 p3) (impC (impC (negC (elC 0 2)) (eqC 0 3)) (elC 0 1))) (impC (elC 0 1) (allC 1 p3)))))

def kcE (a : A) : A := a.push.incT.push.push.incT.par3.cons.push.incT.incT.incT.incT.cons.push.push.incT.incT.cons.push.incT.cons.push.incT.incT.incT.cons.push.push.incT.incT.incT.cons.push.cons.cons.push.incT.incT.cons.push.push.incT.cons.push.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.push.push.incT.cons.push.incT.cons.push.incT.par3.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.select

theorem kcE_eq (a : A) : kcE a = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axE a.p1 a.p2 a.p3 } := by
  simp only [kcE, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B6a (formal parameters `a b c` = `p2 p1 p3`, form 0) -/
def axB6a (p1 p2 p3 : Nat) : Nat := (andC (impC (eqC p2 p1) (allC p3 (eqC p2 p1))) (impC (elC p2 p1) (allC p3 (elC p2 p1))))

def kcB6a (a : A) : A := a.par2.par1.cons.push.cons.par3.par2.par1.cons.push.cons.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.cons.par2.par1.cons.push.incT.cons.par3.par2.par1.cons.push.incT.cons.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.cons.push.incT.incT.incT.cons.b6check.select

theorem kcB6a_eq (a : A) : kcB6a a = { a with ac := a.ac - 1, p2 := 0, p3 := 0, top := if a.ac = 0 then a.top else if a.p2 = a.p3 ∨ a.p3 = a.p1 then 0 else axB6a a.p1 a.p2 a.p3 } := by
  simp only [kcB6a, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- one iteration of main, up to the halt test -/
def iterK (a : A) : A := ((kcB6a (kcE (kcB7 (kcB6b (kcB4 (kcB1 (kcB8a (kcB8c (kcB8b (kcB3 (kcB6c (kcB2 (decodeK a).push))))))))))))).gen.det

set_option maxRecDepth 100000 in
theorem k0_eq (a : A) : k0 a = iterK a := rfl

end TMK.PA
