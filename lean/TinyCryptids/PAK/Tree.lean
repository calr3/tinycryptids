import TinyCryptids.PA.Prog

/-! The program tree of the 10-symbol machine (`pa_nsymbols/kary.py` with 8 digit values),
generated by `pa_nsymbols/gen_klean.py`: for every node its slots, the value its cell holds
when each slot runs (`vals`), the value the slot's transition writes (`wrs`), the value from
which a node skips to its last slot (`skp`), and the tables of the erase, advance and return
states.  Node 0 is main. -/

namespace TMK.PA

/-- a slot: a child node, a register operation (registers in `TM.PA.R`'s order), a break or
continue that erases `h` more cells, a jump to slot `k` of the same node, the end of an
inlined loop, or halt -/
inductive Sl
  | node (c : Nat)
  | inc (r : Fin 10)
  | dec (r : Fin 10)
  | brk (h : Nat)
  | cnt (h : Nat)
  | jmp (k : Nat)
  | done
  | halt
  deriving DecidableEq, Repr

