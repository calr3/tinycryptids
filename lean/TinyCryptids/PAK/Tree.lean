/-- the values that `ebrk e` erases -/
def ebV : Nat → List Nat
  | 1 => [0, 1]
  | _ => []

/-- the values that `ecnt e` erases -/
def ecV : Nat → List Nat
  | 1 => [2]
  | _ => []

/-- the values `adv` advances -/
def advV : List Nat := [0, 1, 2, 3, 4, 5, 6, 7]

/-- the values register operations write (`retok` reads them) -/
def okV : List Nat := [1, 2, 3, 4, 5, 6, 7]

/-- the values `decnz` operations write (`retfail` reads them) -/
def failV : List Nat := [1, 3, 4, 6]

/-- the position of each register in the register file (the order of first use) -/
def mpos : Fin 10 → Nat
  | ⟨0, _⟩ => 0
  | ⟨1, _⟩ => 1
  | ⟨2, _⟩ => 8
  | ⟨3, _⟩ => 7
  | ⟨4, _⟩ => 4
