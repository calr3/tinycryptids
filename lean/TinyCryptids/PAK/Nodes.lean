-- 13: s#132
def d13 : Den := den [.ch 14 d14, .tail (fun s => (.brk 0, (s.set 9 0).set 8 (s.get 8 + s.get 9)))]
theorem e13 : ∀ s, Ex 13 s (d13 s).1 (d13 s).2 :=
  straight_sound (by decide) ⟨rfl, e14, xfer_sound (i := 13) (k := 1) (by decide) (by decide) ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ (fun _ => rfl)⟩ rfl
/-- the unpair step `13` (`[14, decnz scratch2, scratch1++, jmp 1]`): one step of Cantor's order on
`(scratch2, scratch1)`, after `scratch2++` -/
theorem d13_eq (s : R) : d13 s = (.brk 0, if s.s1 = 0 then { s with s1 := s.s2, s2 := 0 } else { s with s1 := s.s1 - 1 }) := by
  by_cases h : s.s1 = 0
  · simp [d13, d14, den, runS, h, TM.PA.R.get, TM.PA.R.set, TM.PA.R.dec]
  · simp [d13, d14, den, runS, chOut, h, TM.PA.R.get, TM.PA.R.set, TM.PA.R.dec]

/-- the body of `12`'s loop: `scratch2++`, then the step -/
def stepU12 (s : R) : R := { s with s2 := (TM.PA.nextP (s.s2, s.s1)).1, s1 := (TM.PA.nextP (s.s2, s.s1)).2 }

theorem d13_body (s : R) : (d13 (s.inc 9)) = (.brk 0, stepU12 s) := by
  rw [d13_eq]
  cases h : s.s1 with
  | zero => simp [stepU12, TM.PA.nextP, h, TM.PA.R.inc]
  | succ n => simp [stepU12, TM.PA.nextP, h, TM.PA.R.inc]

-- 12: unpair(scratch2,scratch1,prooflist).0
/-- `unpair(scratch2,scratch1,prooflist).0`: `n` steps of Cantor's order from `(scratch2, scratch1)` -/
def unpF12 (s : R) : R :=
  (({ s with s2 := (TM.PA.nextN (s.get 0) (s.s2, s.s1)).1, s1 := (TM.PA.nextN (s.get 0) (s.s2, s.s1)).2 } : R).set 0 0)

def d12 : Den := fun s => (.brk 0, unpF12 s)

theorem e12 : ∀ s, Ex 12 s (d12 s).1 (d12 s).2 := by
  intro s
  have hm : SMatch 12 0 [.op (.dec 0), .op (.inc 9), .ch 13 d13, .op (.cnt 0)] :=
    ⟨rfl, rfl, rfl, rfl, rfl, e13, rfl, rfl, rfl⟩
  refine loop_sound (by decide) hm (fun _ => .brk 0) unpF12 (fun s => s.get 0) (fun _ => True) ?_ s trivial
  intro s _
  by_cases h0 : s.get 0 = 0
  · left
    simp only [runS, h0, if_true, unpF12, TM.PA.nextN]
    simp [TM.PA.R.set_eq_of_get h0]
  · right
    obtain ⟨n, hn⟩ : ∃ n, s.get 0 = n + 1 := ⟨s.get 0 - 1, by omega⟩
    refine ⟨stepU12 (s.dec 0), ?_, trivial, ?_, rfl, ?_⟩
    · simp only [runS, h0, if_false]
      rw [d13_body]
      rfl
    · simp [stepU12, TM.PA.R.dec, TM.PA.R.get, TM.PA.R.set] at hn ⊢; omega
    · simp [unpF12, stepU12, TM.PA.R.dec, TM.PA.R.get, TM.PA.R.set] at hn ⊢
      simp [hn, TM.PA.nextN]

