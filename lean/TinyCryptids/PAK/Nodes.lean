-- 75: s#99
/-- `if_eq`'s lockstep loop (node 75): decrement `param2` and `scratch2` together -/
def lsO (s : R) : Res := if s.p2 ≤ s.s2 then .brk 0 else .brk 1
def lsF (s : R) : R := if s.p2 ≤ s.s2 then { s with p2 := 0, s2 := s.s2 - s.p2 } else { s with p2 := 0, s2 := 0 }

def d75 : Den := fun s => (lsO s, lsF s)

theorem e75 : ∀ s, Ex 75 s (d75 s).1 (d75 s).2 := by
  intro s
  have hm : SMatch 75 0 [.op (.dec 6), .ch 76 d76, .ch 77 d77, .op (.brk 1)] :=
    ⟨rfl, rfl, rfl, e76, rfl, e77, rfl, rfl, rfl⟩
  refine loop_sound (by decide) hm lsO lsF (fun s => s.p2) (fun _ => True) ?_ s trivial
  intro s _
  by_cases h0 : s.p2 = 0
  · left
    have : s.get 6 = 0 := h0
    have e : lsF s = s := by cases s; simp_all [lsF]
    simp only [runS, this, if_true, lsO, e, h0, Nat.zero_le, Nat.sub_zero]
  · have h6 : s.get 6 ≠ 0 := h0
    by_cases h9 : s.s2 = 0
    · left
      have hlt : ¬ s.p2 ≤ s.s2 := by omega
      simp [runS, h6, h0, d76, d77, den, lsO, lsF, hlt, h9, TM.PA.R.get, TM.PA.R.dec, TM.PA.R.set]
    · right
      refine ⟨{ s with p2 := s.p2 - 1, s2 := s.s2 - 1 }, ?_, trivial, by simp; omega, ?_, ?_⟩
      · simp [runS, h6, h0, d76, den, chOut, h9, TM.PA.R.get, TM.PA.R.dec, TM.PA.R.set]
      · simp only [lsO]
        by_cases hc : s.p2 ≤ s.s2
        · simp [hc, show s.p2 - 1 ≤ s.s2 - 1 by omega]
        · simp [hc, show ¬ s.p2 - 1 ≤ s.s2 - 1 by omega]
      · simp only [lsF]
        by_cases hc : s.p2 ≤ s.s2
        · simp [hc, show s.p2 - 1 ≤ s.s2 - 1 by omega]; omega
        · simp [hc, show ¬ s.p2 - 1 ≤ s.s2 - 1 by omega]

