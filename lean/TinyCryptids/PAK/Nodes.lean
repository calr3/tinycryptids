-- 21: pair(scratch1,wffstack,topwff).0
/-- `pair`'s loop (from slot 1 of node 21, with `wffstack` zero): `scratch1 += T(topwff)` -/
def pairF (s : R) : R := { s with top := 0, s1 := s.s1 + TM.PA.tri s.top }

theorem pair_loop : ∀ s, s.ws = 0 → Run 21 1 s (.brk 0) (pairF s) := by
  have hm : SMatch 21 1 [.op (.dec 2), .op (.inc 8), .ch 24 d24, .ch 22 d22, .op (.jmp 1)] :=
    ⟨rfl, rfl, rfl, rfl, rfl, e24, rfl, e22, rfl, rfl, rfl⟩
  refine loop_sound (by decide) hm (fun _ => .brk 0) pairF (fun s => s.top) (fun s => s.ws = 0) ?_
  intro s hw
  by_cases h0 : s.top = 0
  · left
    have : s.get 2 = 0 := h0
    have e : pairF s = s := by cases s; simp_all [pairF, TM.PA.tri]
    simp only [runS, this, if_true, e]
  · right
    have : s.get 2 ≠ 0 := h0
    obtain ⟨n, hn⟩ : ∃ n, s.top = n + 1 := ⟨s.top - 1, by omega⟩
    refine ⟨{ s with top := n, s1 := s.s1 + 1 + n }, ?_, hw, by simp [hn], rfl, ?_⟩
    · simp only [runS, this, if_false]
      simp [d24, d22, TM.PA.R.inc, TM.PA.R.dec, TM.PA.R.get, TM.PA.R.set, hn, hw]
    · simp [pairF, hn, TM.PA.tri]; omega

def d21 : Den := fun s => (.brk 0, pairF (d22 s).2)

theorem e21 : ∀ s, Ex 21 s (d21 s).1 (d21 s).2 :=
  fun s => Run.child rfl (e22 s) (pair_loop _ (by simp [d22, TM.PA.R.set, TM.PA.R.get]))

