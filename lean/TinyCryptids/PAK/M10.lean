def compatB : Option (Nat × Dir × St) → Option (Nat × Dir × St2) → Bool
  | none, _ => true
  | some (w, d, q), x => x == some (w, d, phi q)

theorem compat_of {a : Option (Nat × Dir × St)} {x : Option (Nat × Dir × St2)}
    (h : compatB a x = true) : Compat phi a x := by
  match a, h with
  | none, _ => trivial
  | some (w, d, q), h => exact beq_iff_eq.mp h

/-- the nodes below `n`, every symbol below 10 -/
def nodesOK : Nat → Bool
  | 0 => true
  | n + 1 => nodesOK n && (List.range 10).all fun a => compatB (delta (.node n) a) (delta2 (phi (.node n)) a)

theorem nodesOK_le : ∀ n, nodesOK n = true → ∀ i, i < n → ∀ a, a < 10 →
    compatB (delta (.node i) a) (delta2 (phi (.node i)) a) = true := by
  intro n
  induction n with
  | zero => intro _ i hi; omega
  | succ n ih =>
    intro h i hi a ha
    simp only [nodesOK, Bool.and_eq_true, List.all_eq_true, List.mem_range] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact ih h.1 i hi a ha
    · exact h.2 a ha

set_option maxRecDepth 100000 in
theorem nodesOK_all : nodesOK NN = true := by decide

theorem delta_ge (q : St) (a : Nat) (h : 10 ≤ a) : delta q a = none := by
  simp [delta, show ¬ a < 10 by omega]

theorem node_none (i a : Nat) (h : NN ≤ i) : delta (.node i) a = none := by
  have h1 : vals i = [] := getD_ge (by simp [valsT, NN] at h ⊢; omega)
  have h2 : skp i = none := getD_ge (by simp [skpT, NN] at h ⊢; omega)
  unfold delta
  split
  · cases a with
    | zero => rfl
    | succ v => simp [delta0, nodeTr, slotOf, h1, h2, findV]
  · rfl

theorem compat : ∀ q a, Compat phi (delta q a) (delta2 (phi q) a) := by
  intro q a
  apply compat_of
  by_cases ha : a < 10
  · cases q with
    | node i =>
      by_cases h : i < NN
      · exact nodesOK_le NN nodesOK_all i h a ha
      · rw [node_none i a (by omega)]; rfl
    | cinc j =>
      by_cases hj : j ≤ 10
      · revert a; revert j; decide
      · rw [delta_cinc_none j a (by simp only [NR]; omega)]; rfl
    | cdec j =>
      by_cases hj : j ≤ 10
      · revert a; revert j; decide
      · rw [delta_cdec_none j a (by simp only [NR]; omega)]; rfl
    | ebrk e =>
      by_cases he : e ≤ 2
      · revert a; revert e; decide
      · rw [delta_ebrk_none e a (by omega)]; rfl
    | ecnt e =>
      by_cases he : e ≤ 2
      · revert a; revert e; decide
      · rw [delta_ecnt_none e a (by omega)]; rfl
    | _ => revert a; decide
  · rw [delta_ge _ _ (by omega)]; rfl

def start2 : Cfg St2 := ⟨St2.bA, blank, blank⟩

/-- The 10-symbol machine `pa_nsymbols/machines/pa_10sym_470.txt` (122 states, 470
instructions) halts iff the theory T (Tarski's S2 plus Friedman's set existence scheme,
equiconsistent with PA) proves `v0 ∈ v0`, i.e. iff PA is inconsistent. -/
theorem halts_iff : Halts delta2 start2 ↔ TinyCryptids.Wff.Provable (TinyCryptids.Wff.el 0 0) :=
  halts_iff_of_sim delta delta2 phi compat start TMK.PA.halts_iff
    (fun h => let ⟨c, hr, hq⟩ := haltAt_of h; ⟨c, hr, by rw [hq]; rfl⟩)

