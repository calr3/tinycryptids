import TinyCryptids.SophieGermain.Main

/-! M17: 17-state machine generated by `gen_reduced_lean.py` from `machines/sophiegermain_17.txt`.
Its beep transition is `G0` reading 0. -/

namespace TM.SophieGermain

open TinyCryptids

namespace M17

inductive St2
  | B2
  | Y1
  | Y2
  | A2
  | A3
  | W1
  | W3
  | Z1
  | Z2
  | E
  | V
  | X
  | K1
  | K2
  | K3
  | H
  | G0
  | halt2
deriving DecidableEq, Repr

open St2 Dir in
def delta2 : St2 → Bool → Option (Bool × Dir × St2)
  | B2, false => some (false, L, E)
  | B2, true => some (false, L, Y1)
  | Y1, false => some (false, L, Y2)
  | Y1, true => some (true, L, Y1)
  | Y2, false => some (true, R, A2)
  | Y2, true => some (true, L, Y2)
  | A2, false => some (false, L, W3)
  | A2, true => some (true, R, A3)
  | A3, false => some (false, L, W1)
  | A3, true => some (false, R, Z1)
  | W1, false => some (false, R, A3)
  | W1, true => some (true, L, W1)
  | W3, false => some (false, R, A2)
  | W3, true => some (true, L, W3)
  | Z1, false => some (false, R, Z2)
  | Z1, true => some (true, R, Z1)
  | Z2, false => some (true, R, B2)
  | Z2, true => some (true, R, Z2)
  | E, false => some (false, L, V)
  | E, true => some (false, R, B2)
  | V, false => some (false, L, X)
  | V, true => some (true, L, V)
  | X, false => some (true, R, K1)
  | X, true => some (true, L, X)
  | K1, false => some (true, R, G0)
  | K1, true => some (true, R, K2)
  | K2, false => some (true, R, V)
  | K2, true => some (true, R, K3)
  | K3, false => some (true, L, V)
  | K3, true => some (true, R, H)
  | H, false => some (true, R, G0)
  | H, true => some (true, R, H)
  | G0, false => some (false, L, V)
  | G0, true => some (false, R, B2)
  | halt2, _ => none

def phi : St → St2
  | St.B2 => St2.B2
  | St.Y1 => St2.Y1
  | St.Y2 => St2.Y2
  | St.A2 => St2.A2
  | St.A3 => St2.A3
  | St.W1 => St2.W1
  | St.W3 => St2.W3
  | St.Z1 => St2.Z1
  | St.Z2 => St2.Z2
  | St.E => St2.E
  | St.V => St2.V
  | St.X => St2.X
  | St.K1 => St2.K1
  | St.K2 => St2.K2
  | St.K3 => St2.K3
  | St.H => St2.H
  | St.G0 => St2.G0
  | St.halt => St2.halt2

theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

/-- the merged beep state plays only the design's beep state on symbol 0 -/
theorem excl : ∀ q, phi q = phi St.G0 → q = St.G0 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.B2, blank, blank⟩

/-- The beep transition: `G0` reading 0. -/
theorem beep_transition : delta2 St2.G0 false = some (false, Dir.L, St2.V) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.SophieGermain.never_halts

theorem quasihalts_iff :
    QuasiHalts delta2 St2.G0 false start2 ↔ FinitelyManySophieGermainPrimes :=
  (quasihalts_iff_of_sim delta delta2 phi compat start TM.SophieGermain.never_halts St.G0 false
    excl).trans TM.SophieGermain.quasihalts_iff

end M17

end TM.SophieGermain
