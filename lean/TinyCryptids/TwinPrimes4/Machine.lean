import TinyCryptids.Core.Multi

/-!
The 10-state, 4-symbol machine, generated by `twinprimes/sym4/gen_lean.py` from `twinprimes4.txt`.
`delta` is the machine; `deltaNB` is `delta` without its beep transition (`beep` reading 0).
-/

namespace TMK.TwinPrimes4

inductive St
  | reb
  | toR
  | cur
  | toM
  | adv
  | wrap
  | chk2
  | chk3
  | grow
  | beep
deriving DecidableEq, Repr

open St TM.Dir in
def delta : St → Nat → Option (Nat × TM.Dir × St)
  | reb, 0 => some (3, R, grow)
  | reb, 1 => some (1, L, reb)
  | reb, 3 => some (1, R, reb)
  | toR, 0 => some (0, L, cur)
  | toR, 1 => some (1, R, toR)
  | toR, 2 => some (1, L, cur)
  | toR, 3 => some (3, R, toR)
  | cur, 1 => some (2, L, toM)
  | cur, 2 => some (1, R, reb)
  | cur, 3 => some (3, L, chk2)
  | toM, 1 => some (1, L, toM)
  | toM, 2 => some (3, R, adv)
  | toM, 3 => some (3, L, toM)
  | adv, 1 => some (1, L, wrap)
  | adv, 2 => some (2, L, wrap)
  | adv, 3 => some (2, R, toR)
  | wrap, 0 => some (0, R, adv)
  | wrap, 2 => some (3, R, grow)
  | wrap, 3 => some (3, L, wrap)
  | chk2, 2 => some (3, R, grow)
  | chk2, 3 => some (3, L, chk3)
  | chk3, 2 => some (1, R, reb)
  | chk3, 3 => some (3, L, wrap)
  | grow, 0 => some (1, R, beep)
  | grow, 1 => some (2, R, toR)
  | grow, 3 => some (3, R, grow)
  | beep, 0 => some (0, L, reb)
  | _, _ => none

/-- `delta` without its beep transition (`beep` reading 0) -/
def deltaNB (q : St) (b : Nat) : Option (Nat × TM.Dir × St) :=
  if q = St.beep ∧ b = 0 then none else delta q b

def start : Cfg St := ⟨St.reb, blank, blank⟩

end TMK.TwinPrimes4
