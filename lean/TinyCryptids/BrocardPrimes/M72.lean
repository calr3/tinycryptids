theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ p q, 3 ≤ p ∧ TinyCryptids.Prime p ∧ TinyCryptids.Prime q ∧ p < q ∧ (∀ r, p < r → r < q → ¬ TinyCryptids.Prime r) ∧ TinyCryptids.primeCount (q ^ 2) - TinyCryptids.primeCount (p ^ 2) < 4 :=
  halts_iff_of_sim delta delta2 phi compat start TM.BrocardPrimes.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

