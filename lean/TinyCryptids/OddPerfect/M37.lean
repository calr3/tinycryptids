theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ n, n % 2 = 1 ∧ properDivSum n = n :=
  halts_iff_of_sim delta delta2 phi compat start TM.OddPerfect.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of_opn h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

