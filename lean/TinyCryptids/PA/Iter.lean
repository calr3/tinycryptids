/-- one iteration of main, up to the halt test -/
def iter (a : A) : A := a.decode.push.candE.candB2.candB8c.candB8b.candB8a.candB3.candB7.candB4.candB6b.candB1.candB6c.candB6a.gen.det

end A

open N

set_option maxRecDepth 10000 in
