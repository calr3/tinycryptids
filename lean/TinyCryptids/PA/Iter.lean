    rfl
  have e2 : h0 a.emb = h215 (A.iter a).emb := by
    simp only [f0, f2, f6, f10, f15, f20, f24, f27, f30, f33, f37, f40, f42, f44, f45, f47, f48, f50, f51, f54, f55, f60, f61, f62, f67, f68, f69, f70, f76, f77, f78, f79, f82, f83, f86, f89, f90, f92, f93, f94, f95, f96, f97, f98, f99, f100, f101, f102, f103, f104, f105, f106, f107, f108, f110, f111, f114, f115, f118, f121, f122, f124, f125, f126, f127, f128, f129, f130, f131, f132, f133, f134, f135, f136, f139, f140, f143, f144, f145, f148, f149, f150, f151, f152, f153, f154, f155, f156, f157, f158, f159, f160, f161, f162, f163, f164, f165, f166, f167, f168, f169, f170, f171, f172, f173, f174, f175, f176, f177, f178, f179, f180, f181, f182, f183, f184, f185, f186, f187, f188, f190, f192, f194, f197, f201, f206, f209, f210, f212, h0, h2, h6, h10, h15, h20, h24, h27, h30, h33, h37, h40, h42, h45, h48, h51, h55, h62, h70, h79, h83, h86, h90, h94, h97, h99, h100, h101, h103, h105, h107, h110, h115, h118, h122, h126, h130, h136, h140, h145, h150, h152, h153, h154, h155, h157, h158, h160, h162, h164, h165, h166, h167, h168, h170, h171, h172, h173, h174, h176, h177, h178, h179, h180, h181, h182, h184, h185, h186, h187, h188, h190, h192, h194, h197, h201, h206, h209, h210, h212, cons_emb, det_emb, gen_emb, par1_emb, par2_emb, par3_emb, push_emb, reload_emb, select_emb, zeroAc_emb, zeroP1_emb, zeroP3_emb, incT_emb, push_emb', decAc_emb, decP1_emb, decP2_emb, decP3_emb, b6check_emb]
