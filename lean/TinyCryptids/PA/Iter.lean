import TinyCryptids.PA.Abs

/-! Main's chain of subroutines as one operation on the abstract registers, generated by
`pa/gen_iter.py`: the decoding, `v_0` (push the last theorem), one function per candidate
(its formula built on the stack, then `select`), GEN and DET; `main_emb` proves that node 0
computes it, followed by the halt test. -/

namespace TM.PA

namespace A

def decode (a : A) : A := a.reload.zeroAc.zeroP1.zeroP3.decAc.decP1.decP2.decP3

/-- candidate E -/
def candE (a : A) : A := a.push.incT.push.push.incT.par3.cons.push.incT.incT.incT.incT.cons.push.push.incT.incT.cons.push.incT.cons.push.incT.incT.incT.cons.push.push.incT.incT.incT.cons.push.cons.cons.push.incT.incT.cons.push.push.incT.cons.push.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.push.push.incT.cons.push.incT.cons.push.incT.par3.cons.push.incT.incT.incT.incT.cons.cons.push.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.cons.push.incT.incT.incT.incT.cons.push.incT.incT.incT.cons.select

/-- candidate B2 -/
def candB2 (a : A) : A := a.par3.push.incT.incT.incT.cons.par3.cons.push.incT.incT.cons.par3.cons.push.incT.incT.cons.select

/-- candidate B8c -/
def candB8c (a : A) : A := a.par2.par1.cons.push.cons.par3.par2.cons.push.incT.cons.par3.par1.cons.push.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

/-- candidate B8b -/
def candB8b (a : A) : A := a.par2.par3.cons.push.cons.par2.par1.cons.push.incT.cons.par3.par1.cons.push.incT.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

/-- candidate B8a -/
def candB8a (a : A) : A := a.par2.par3.cons.push.cons.par2.par1.cons.push.cons.par3.par1.cons.push.cons.cons.push.incT.incT.cons.cons.push.incT.incT.cons.select

