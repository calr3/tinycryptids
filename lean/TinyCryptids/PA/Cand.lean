import TinyCryptids.PA.Iter
import TinyCryptids.PA.Code

/-! The candidates of an iteration, generated by `pa/gen_cand.py`: each axiom of the
theory in the form and relabelling of `program.py` (`VARIANTS`, `FORMS`), as a code over
the parameters `p1 p2 p3`, and the lemma that its chain of operations computes it. -/

namespace TM.PA

-- every candidate takes all three parameters, some ignore one
set_option linter.unusedVariables false

/-- E (formal parameters `a b c` = `p3 p1 p2`, form 1) -/
def axE (p1 p2 p3 : Nat) : Nat := (exC 1 (allC 0 (andC (impC (allC 1 p3) (impC (impC (negC (elC 0 2)) (eqC 0 3)) (elC 0 1))) (impC (elC 0 1) (allC 1 p3)))))

theorem candE_eq (a : A) : a.candE = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axE a.p1 a.p2 a.p3 } := by
  simp only [A.candE, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B2 (formal parameters `a b c` = `p3 p2 p1`, form 0) -/
def axB2 (p1 p2 p3 : Nat) : Nat := (impC (impC (negC p3) p3) p3)

theorem candB2_eq (a : A) : a.candB2 = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB2 a.p1 a.p2 a.p3 } := by
  simp only [A.candB2, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
  rfl

/-- B8c (formal parameters `a b c` = `p2 p1 p3`, form 0) -/
def axB8c (p1 p2 p3 : Nat) : Nat := (impC (eqC p2 p1) (impC (elC p3 p2) (elC p3 p1)))

theorem candB8c_eq (a : A) : a.candB8c = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB8c a.p1 a.p2 a.p3 } := by
