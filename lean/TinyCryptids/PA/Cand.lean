/-- B1 (formal parameters `a b c` = `p3 p2 p1`, form 0) -/
def axB1 (p1 p2 p3 : Nat) : Nat := (impC (impC p3 p2) (impC (impC p2 p1) (impC p3 p1)))

theorem candB1_eq (a : A) : a.candB1 = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB1 a.p1 a.p2 a.p3 } := by
