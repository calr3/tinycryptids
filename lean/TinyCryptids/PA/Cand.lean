/-- B6c (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB6c (p1 p2 p3 : Nat) : Nat := (impC (exC p2 (allC p2 p3)) p3)

theorem candB6c_eq (a : A) : a.candB6c = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB6c a.p1 a.p2 a.p3 } := by
