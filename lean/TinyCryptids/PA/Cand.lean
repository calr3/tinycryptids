/-- B6a (formal parameters `a b c` = `p2 p1 p3`, form 0) -/
def axB6a (p1 p2 p3 : Nat) : Nat := (andC (impC (eqC p2 p1) (allC p3 (eqC p2 p1))) (impC (elC p2 p1) (allC p3 (elC p2 p1))))

theorem candB6a_eq (a : A) : a.candB6a = { a with ac := a.ac - 1, p2 := 0, p3 := 0, top := if a.ac = 0 then a.top else if a.p2 = a.p3 ∨ a.p3 = a.p1 then 0 else axB6a a.p1 a.p2 a.p3 } := by
  simp only [A.candB6a, A.push_a, A.par1_a, A.par2_a, A.par3_a, A.push_ts, A.incT_ts, A.par1_ts, A.par2_ts, A.par3_ts, A.cons_ts, A.select_ts, A.b6check_ts, A.ts_ts, A.ts_top, A.ts_stk, A.ts_p1, A.ts_p2, A.ts_p3, A.ts_ac]
