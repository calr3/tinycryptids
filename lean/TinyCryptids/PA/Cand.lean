  rfl

/-- B4 (formal parameters `a b c` = `p1 p3 p2`, form 1) -/
def axB4 (p1 p2 p3 : Nat) : Nat := (impC (allC p1 p3) (impC (allC p1 (impC p3 p2)) (allC p1 p2)))

