  rfl

/-- B8b (formal parameters `a b c` = `p2 p3 p1`, form 0) -/
def axB8b (p1 p2 p3 : Nat) : Nat := (impC (eqC p2 p3) (impC (elC p2 p1) (elC p3 p1)))

theorem candB8b_eq (a : A) : a.candB8b = { a with ac := a.ac - 1, top := if a.ac = 0 then a.top else axB8b a.p1 a.p2 a.p3 } := by
