theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

def start2 : Cfg St2 := ⟨St2.seed0, blank, blank⟩

theorem halts_iff :
    Halts delta2 start2 ↔ ∃ n, 1 ≤ n ∧ ∀ p, n ^ 2 < p → p < (n + 1) ^ 2 → ¬ Prime p :=
  halts_iff_of_sim delta delta2 phi compat start TM.Legendre.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of_fails (let ⟨n, h1, h2⟩ := h; ⟨n, h1, h2⟩); ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

