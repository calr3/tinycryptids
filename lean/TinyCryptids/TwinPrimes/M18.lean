import TinyCryptids.TwinPrimes.Main

/-! M18: 18-state machine generated by `gen_reduced_lean.py` from `machines/twinprimes_18.txt`.
Its beep transition is `G2` reading 0. -/

namespace TM.TwinPrimes

open TinyCryptids

namespace M18

inductive St2
  | Z2
  | B2
  | Y1
  | Y2
  | A2
  | W1
  | Z1
  | X1
  | X2
  | X3
  | H0
  | H1
  | G1
  | G2
  | SC
  | C1
  | C4
  | C5
  | halt2
deriving DecidableEq, Repr

open St2 Dir in
def delta2 : St2 → Bool → Option (Bool × Dir × St2)
  | Z2, false => some (true, L, B2)
  | Z2, true => some (true, R, Z2)
  | B2, false => some (false, L, X1)
  | B2, true => some (false, L, Y1)
  | Y1, false => some (false, L, Y2)
  | Y1, true => some (true, L, Y1)
  | Y2, false => some (true, R, A2)
  | Y2, true => some (true, L, Y2)
  | A2, false => some (false, L, W1)
  | A2, true => some (false, R, Z1)
  | W1, false => some (false, R, A2)
  | W1, true => some (true, L, W1)
  | Z1, false => some (false, R, Z2)
  | Z1, true => some (true, R, Z1)
  | X1, false => some (true, R, C1)
  | X1, true => some (true, L, X2)
  | X2, false => some (true, R, H1)
  | X2, true => some (true, L, X3)
  | X3, false => some (true, R, C1)
  | X3, true => some (true, L, H0)
  | H0, false => some (true, R, H1)
  | H0, true => some (true, L, H0)
  | H1, false => some (false, R, G1)
  | H1, true => some (true, R, H1)
  | G1, false => none
  | G1, true => some (false, R, G2)
  | G2, false => some (false, L, B2)
  | G2, true => some (true, R, SC)
  | SC, false => some (false, L, B2)
  | SC, true => some (true, R, SC)
  | C1, false => some (true, L, C4)
  | C1, true => some (true, R, C1)
  | C4, false => some (true, R, C5)
  | C4, true => some (true, L, C4)
  | C5, false => none
  | C5, true => some (false, R, G1)
  | halt2, _ => none

def phi : St → St2
  | St.Z2 => St2.Z2
  | St.B2 => St2.B2
  | St.Y1 => St2.Y1
  | St.Y2 => St2.Y2
  | St.A2 => St2.A2
  | St.W1 => St2.W1
  | St.W2 => St2.A2
  | St.Z1 => St2.Z1
  | St.X1 => St2.X1
  | St.X2 => St2.X2
  | St.X3 => St2.X3
  | St.H0 => St2.H0
  | St.H1 => St2.H1
  | St.G1 => St2.G1
  | St.G2 => St2.G2
  | St.SC => St2.SC
  | St.C1 => St2.C1
  | St.C4 => St2.C4
  | St.C5 => St2.C5
  | St.halt => St2.halt2

theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

/-- the merged beep state plays only the design's beep state on symbol 0 -/
theorem excl : ∀ q, phi q = phi St.G2 → q = St.G2 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.Z2, blank, blank⟩

/-- The beep transition: `G2` reading 0. -/
theorem beep_transition : delta2 St2.G2 false = some (false, Dir.L, St2.B2) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.TwinPrimes.never_halts

theorem quasihalts_iff :
    QuasiHalts delta2 St2.G2 false start2 ↔ ¬ TwinPrimeConjecture :=
  (quasihalts_iff_of_sim delta delta2 phi compat start TM.TwinPrimes.never_halts St.G2 false
    excl).trans TM.TwinPrimes.quasihalts_iff

end M18

end TM.TwinPrimes
