set_option maxHeartbeats 0 in
theorem compat : ∀ q b, Compat phi (delta q b) (delta2 (phi q) b) := by
  intro q b; cases q <;> cases b <;> first | trivial | rfl

set_option maxHeartbeats 0 in
/-- the merged beep state plays only the design's beep state on symbol 1 -/
theorem excl_beep : ∀ q, phi q = phi St.zX3 → q = St.zX3 ∨ delta q true = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

set_option maxHeartbeats 0 in
/-- the merged boop state plays only the design's boop state on symbol 0 -/
theorem excl_boop : ∀ q, phi q = phi St.zX3 → q = St.zX3 ∨ delta q false = none := by
  intro q h; cases q <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)

def start2 : Cfg St2 := ⟨St2.sd0, blank, blank⟩

/-- The beep transition: `zX3` reading 1. -/
theorem beep_transition : delta2 St2.zX3 true = some (false, Dir.L, St2.zX3) := rfl

/-- The boop transition: `zX3` reading 0. -/
theorem boop_transition : delta2 St2.zX3 false = some (false, Dir.L, St2.cr3) := rfl

theorem never_halts : ¬ Halts delta2 start2 :=
  not_halts_of_sim delta delta2 phi compat start TM.Pillai.never_halts

theorem repeats_iff :
    RepeatsForever delta2 St2.zX3 true St2.zX3 false start2 ↔ ¬ PillaiConjecture :=
  (repeatsForever_iff_of_sim delta delta2 phi compat start TM.Pillai.never_halts St.zX3 true
    St.zX3 false excl_beep excl_boop).trans TM.Pillai.repeats_iff

