theorem halts_iff :
    Halts delta2 start2 ↔ ∃ x y m n, 1 < y ∧ y < x ∧ 2 < m ∧ 2 < n ∧ rep x m = rep y n ∧ rep x m ≠ 31 ∧ rep x m ≠ 8191 :=
  halts_iff_of_sim delta delta2 phi compat start TM.Goormaghtigh.halts_iff
    (fun h => let ⟨L, R, hr⟩ := haltAt_of_conj h; ⟨⟨St.halt, L, R⟩, hr, rfl⟩)

