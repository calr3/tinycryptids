import TinyCryptids.Core.Basic

/-! The 16-state design, generated by `gen_lean.py` from `weakcollatz.txt`. -/

namespace TM.WeakCollatz16

inductive St
  | fill
  | cut
  | home
  | disp
  | mark
  | toH
  | stepH
  | back
  | hop2
  | backO
  | markO
  | toHO
  | hop1
  | toHN
  | peek
  | grow
  | halt
deriving DecidableEq, Repr

open St Dir in
def delta : St → Bool → Option (Bool × Dir × St)
  | fill, false => some (true, R, grow)
  | fill, true => some (true, L, fill)
  | cut, false => some (false, L, home)
  | cut, true => some (false, L, home)
  | home, false => some (false, R, disp)
  | home, true => some (true, L, home)
  | disp, false => some (true, R, grow)
  | disp, true => some (true, R, mark)
  | mark, false => some (true, L, cut)
  | mark, true => some (false, R, toH)
  | toH, false => some (true, L, stepH)
  | toH, true => some (true, R, toH)
  | stepH, false => some (false, R, hop2)
  | stepH, true => some (false, L, back)
  | back, false => some (true, R, mark)
  | back, true => some (true, L, back)
  | hop2, false => some (false, L, fill)
  | hop2, true => some (false, L, backO)
  | backO, false => some (true, L, markO)
  | backO, true => some (true, L, backO)
  | markO, false => some (false, R, toHN)
  | markO, true => some (false, R, toHO)
  | toHO, false => some (true, R, hop1)
  | toHO, true => some (true, R, toHO)
  | hop1, false => some (false, L, fill)
  | hop1, true => some (true, R, hop2)
  | toHN, false => some (false, R, peek)
  | toHN, true => some (true, R, toHN)
  | peek, false => some (false, R, halt)
  | peek, true => some (true, L, cut)
  | grow, false => some (false, L, home)
  | grow, true => some (true, R, grow)
  | halt, _ => none

def start : Cfg St := ⟨St.fill, blank, blank⟩

end TM.WeakCollatz16
