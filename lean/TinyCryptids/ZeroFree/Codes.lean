import TinyCryptids.ZeroFree.Spec

/-! The digit codes of `build.py`, generated by `gen_lean.py`. A decimal digit `d = 2a + b`
takes the parity `b`, then the three cells of code A of `a` (between rounds), or of code B,
which the pass writes from the old digit (`B[d mod 2, d / 2]`). -/

namespace TM.ZeroFree

open D

/-- cell x of code A of digit `d` (of `a = d / 2`) -/
def ax : D → Bool
  | d0 => false
  | d1 => false
  | d2 => false
  | d3 => false
  | d4 => false
  | d5 => false
  | d6 => true
  | d7 => true
  | d8 => true
  | d9 => true

/-- cell y of code A of digit `d` (of `a = d / 2`) -/
def ay : D → Bool
  | d0 => true
  | d1 => true
  | d2 => false
  | d3 => false
  | d4 => true
  | d5 => true
  | d6 => true
  | d7 => true
  | d8 => false
  | d9 => false

/-- cell z of code A of digit `d` (of `a = d / 2`) -/
def az : D → Bool
  | d0 => false
  | d1 => false
  | d2 => true
  | d3 => true
  | d4 => true
  | d5 => true
  | d6 => true
  | d7 => true
  | d8 => true
  | d9 => true

/-- cell x of code B written for the old digit `d` -/
def qx : D → Bool
  | d0 => false
  | d1 => true
  | d2 => false
  | d3 => true
  | d4 => false
  | d5 => true
  | d6 => true
  | d7 => false
  | d8 => true
  | d9 => false

/-- cell y of code B written for the old digit `d` -/
def qy : D → Bool
  | d0 => true
  | d1 => true
  | d2 => false
  | d3 => false
  | d4 => true
  | d5 => true
  | d6 => true
  | d7 => false
  | d8 => false
  | d9 => true

/-- cell z of code B written for the old digit `d` -/
def qz : D → Bool
  | d0 => false
  | d1 => true
  | d2 => true
  | d3 => true
  | d4 => true
  | d5 => false
  | d6 => true
  | d7 => true
  | d8 => true
  | d9 => true

end TM.ZeroFree
